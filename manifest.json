{
  "manifest_version": 3,
  "name": "Pabal AI Auto Bot",
  "version": "1.1",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://pabal.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://pabal.ai/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
